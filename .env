# =====================================================================
#  ReservaBot · Configuración de la Landing Page
# ---------------------------------------------------------------------
#  TODO lo que ves en la web se controla desde este archivo.
#  Reglas rápidas:
#    - Toda variable DEBE empezar por REACT_APP_ (requisito de React).
#    - Las listas se separan con el caracter  |  (pipe).
#    - Los booleanos aceptan: true / false  (también si / no / 1 / 0).
#    - Deja una variable VACIA para ocultar ese elemento en la web.
#    - Después de editar este archivo hay que REINICIAR (npm start)
#      o volver a compilar (npm run build). No basta con recargar.
# =====================================================================


# =====================================================================
#  0. BUILD
# =====================================================================
# Ruta pública desde donde se sirven los assets.
# Vacío = usa el campo "homepage" del package.json
PUBLIC_URL=


# =====================================================================
#  1. MARCA
# =====================================================================
REACT_APP_BRAND_NAME=ReservaBot
# El nombre se pinta en 2 partes para darle color al sufijo
REACT_APP_BRAND_NAME_PREFIX=Reserva
REACT_APP_BRAND_NAME_SUFFIX=Bot
REACT_APP_BRAND_TAGLINE=Recepcionista digital 24/7
REACT_APP_BRAND_SLOGAN=Tu recepcionista que nunca duerme
REACT_APP_BRAND_DESCRIPTION=Tu barbería o salón de uñas agenda solo, 24/7. ReservaBot atiende a tus clientes con un chatbot inteligente: reserva la cita, la confirma y la recuerda. Menos plantones, más clientes.

# Logo: usa una ruta local (/images/...) o una URL completa (https://...)
REACT_APP_LOGO_URL=/images/brand/logo-reservabot.svg
REACT_APP_LOGO_ICON_URL=/images/brand/isotipo-reservabot.svg
REACT_APP_LOGO_HEIGHT_DESKTOP=44
REACT_APP_LOGO_HEIGHT_MOBILE=34
# false = ignora la imagen y muestra el nombre en texto
REACT_APP_SHOW_LOGO_IMAGE=true

REACT_APP_SITE_URL=https://reservabot.online
REACT_APP_COMPANY_NAME=ReservaBot
REACT_APP_COMPANY_LEGAL_NAME=ReservaBot


# =====================================================================
#  2. COLORES Y TIPOGRAFÍA  (identidad visual)
#     Verde ReservaBot sobre azul noche, igual que la marca en redes.
# =====================================================================
REACT_APP_COLOR_PRIMARY="#22DE7A"
REACT_APP_COLOR_PRIMARY_DARK="#12B45F"
# Acento de barberías (cian) y de uñas (rosa)
REACT_APP_COLOR_SECONDARY="#38BDF8"
REACT_APP_COLOR_ACCENT="#FF5FA2"
REACT_APP_COLOR_BG="#08131F"
REACT_APP_COLOR_BG_DEEP="#050D16"
REACT_APP_COLOR_SURFACE="#0F2233"
REACT_APP_COLOR_TEXT="#F2F7FA"
REACT_APP_COLOR_TEXT_MUTED="#93AABD"
REACT_APP_FONT_HEADING=Montserrat
REACT_APP_FONT_BODY=Inter
# Redondeo global de tarjetas y botones (px)
REACT_APP_RADIUS=20


# =====================================================================
#  3. CONTACTO  (WhatsApp es el canal de VENTAS: por ahí se pide el demo)
# =====================================================================
# Número con indicativo, SIN + ni espacios
REACT_APP_WHATSAPP_NUMBER=573161208714
REACT_APP_WHATSAPP_DISPLAY=+57 316 120 8714
REACT_APP_WHATSAPP_MESSAGE=¡Hola! Quiero mi DEMO GRATIS de ReservaBot y activar el primer mes gratis 🚀
