REACT_APP_HERO_IMAGE=/images/mockups/hero-app.svg
REACT_APP_HERO_IMAGE_ALT=Conversación con el chatbot de ReservaBot agendando una cita

# Tarjetas flotantes animadas sobre el mockup:  Titulo::Texto
REACT_APP_HERO_FLOAT_1=Nueva reserva::Andrés · Corte + barba · 3:30 pm
REACT_APP_HERO_FLOAT_2=Recordatorio enviado::12 clientas notificadas en la app

# Conversación animada del hero (así se ve el chatbot).  Formato:  in|out::mensaje
#   in  = mensaje del cliente (izquierda)
#   out = respuesta de ReservaBot (derecha, en verde)
# Usa \n para saltos de línea dentro de un mismo mensaje.
REACT_APP_HERO_CHAT_HEADER=ReservaBot
REACT_APP_HERO_CHAT_STATUS=en línea
REACT_APP_HERO_CHAT_1=in::Hola 👋 Quiero manicure hoy
REACT_APP_HERO_CHAT_2=out::¡Claro! Tengo 3:00 pm y 5:30 pm ✨
REACT_APP_HERO_CHAT_3=in::3:00 pm
REACT_APP_HERO_CHAT_4=out::✅ Cita confirmada\nHoy 3:00 pm · Manicure
REACT_APP_HERO_CHAT_5=out::Te recordaré 2 h antes ⏰
REACT_APP_HERO_CHAT_6=in::¡Gracias! 🙌
REACT_APP_HERO_CHAT_7=
REACT_APP_HERO_CHAT_8=

# Indicadores rápidos bajo el titular (máximo 3 visibles)
REACT_APP_STAT_1_VALUE=24/7
REACT_APP_STAT_1_LABEL=Atención
REACT_APP_STAT_2_VALUE=0
REACT_APP_STAT_2_LABEL=Mensajes sin responder
REACT_APP_STAT_3_VALUE=2 min
REACT_APP_STAT_3_LABEL=Para reservar
REACT_APP_STAT_4_VALUE=
REACT_APP_STAT_4_LABEL=


